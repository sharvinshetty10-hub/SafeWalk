rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the caller is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Match users documents
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subcollection for emergency contacts
      match /contacts/{contactId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection for safety alerts
      match /alerts/{alertId} {
        // Users can create, update, or delete their own alerts
        allow create, update, delete: if isOwner(userId);
        
        // Authenticated users can read any alert to track friends in distress
        allow read: if isAuthenticated();
      }
    }
  }
}
